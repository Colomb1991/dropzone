{
 "version": 8,
 "name": "dropzone-dark",
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#151515"
   }
  },
  {
   "id": "landcover",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "wood",
     "grass",
     "farmland"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#182618",
    "fill-opacity": 0.7
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#182618"
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#0E2A40"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#0E2A40",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     14,
     1.5,
     19,
     6
    ]
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 14,
   "paint": {
    "fill-color": "#222222",
    "fill-outline-color": "#333333"
   }
  },
  {
   "id": "path",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 14,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "path",
     "pedestrian"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#555555",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     14,
     1,
     19,
     4
    ],
    "line-dasharray": [
     2,
     2
    ]
   }
  },
  {
   "id": "rail",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 11,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "rail",
     "transit"
    ],
    true,
    false
   ],
   "paint": {
    "line-color": "#555555",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     14,
     1,
     19,
     3
    ]
   }
  },
  {
   "id": "road-minor-casing",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 12,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "minor",
     "service",
     "track",
     "busway"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#0A0A0A",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     14,
     3.5,
     19,
     22
    ]
   }
  },
  {
   "id": "road-major-casing",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk",
     "primary",
     "secondary",
     "tertiary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#0A0A0A",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     1.5,
     14,
     6,
     19,
     30
    ]
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 12,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "minor",
     "service",
     "track",
     "busway"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#3A3A3A",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     0.3,
     14,
     2.5,
     19,
     19
    ]
   }
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk",
     "primary",
     "secondary",
     "tertiary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#6B6540",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.6
     ],
     [
      "zoom"
     ],
     8,
     1,
     14,
     4.5,
     19,
     26
    ]
   }
  },
  {
   "id": "boundary",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "<=",
    [
     "get",
     "admin_level"
    ],
    4
   ],
   "paint": {
    "line-color": "#888888",
    "line-width": 1,
    "line-dasharray": [
     3,
     2
    ]
   }
  },
  {
   "id": "road-label",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "transportation_name",
   "minzoom": 13,
   "layout": {
    "symbol-placement": "line",
    "text-field": [
     "coalesce",
     [
      "get",
      "name:latin"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     13,
     11,
     18,
     16
    ]
   },
   "paint": {
    "text-color": "#EEEEEE",
    "text-halo-color": "#111111",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "housenumber",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "housenumber",
   "minzoom": 17,
   "layout": {
    "text-field": [
     "get",
     "housenumber"
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 12
   },
   "paint": {
    "text-color": "#BBBBBB",
    "text-halo-color": "#111111",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "place-small",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "minzoom": 11,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "village",
     "suburb",
     "neighbourhood",
     "quarter",
     "hamlet"
    ],
    true,
    false
   ],
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:latin"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 13,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#BBBBBB",
    "text-halo-color": "#111111",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "place-town",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "city",
     "town"
    ],
    true,
    false
   ],
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:latin"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     6,
     12,
     14,
     20
    ],
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#EEEEEE",
    "text-halo-color": "#111111",
    "text-halo-width": 1.5
   }
  }
 ]
}
